# Copy to .env. Never put B2 or model credentials into the mobile app.
HOST=0.0.0.0
PORT=8080
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
DATA_DIR=./runtime
# local is a development substitute. Use b2 for the real pipeline.
STORAGE_DRIVER=local
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
# disabled: wait; local: packaged LeafCNN; http: external service; demo: simulated results
MODEL_MODE=gpu
MODEL_URL=
MODEL_TOKEN=
LOCAL_MODEL_DIR=../outputs/models/leaf-cnn-epoch6
MODEL_TIMEOUT_MS=120000
INFERENCE_CPU_THREADS=8
INFERENCE_MEMORY_FORMAT=channels_last
DEMO_VERDICT=diseased
# Leaf candidates are proposed AFTER the SegFormer-B2 ground mask.
LEAF_CROP_MODE=heuristic
GROUND_MASK_MODE=local
GROUND_MODEL_DIR=./models/PlantLeafPipeline/models/segformer-b2-ade20k
# In provided mode, upload a binary PNG ground_mask instead of running SegFormer.
# Windows: py; Linux/macOS: python3 (Docker sets this automatically)
PYTHON_BIN=py
# Optional development dependencies directory; leave empty for installed packages.
PYTHON_MODULE_PATH=
LEAF_WINDOW_MODE=tight
MIN_LEAF_EXTENT=80
MAX_LEAF_CANDIDATES=40
# Lower values accept softer 720p frames/crops; original v2 values were .0025/.001.
LEAF_BLUR_THRESHOLD=0.00025
MIN_CROP_SHARPNESS=0.0001
CROP_TIMEOUT_MS=120000

GPU_MODEL_DIR=./models/LeafCNN-Epoch8-GPU
LEAF_HEURISTIC_VERSION=v2
