[Unit]
Description=plantbot rover
After=network-online.target
Wants=network-online.target

[Service]
# @USER@ and @DIR@ are filled in by deploy/setup_pi.sh
User=@USER@
WorkingDirectory=@DIR@
ExecStart=@DIR@/.venv/bin/python -m plantbot
Restart=always
RestartSec=2
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
