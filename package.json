{
  "name": "leaflink-pipeline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node setup.js --start",
    "start:legacy": "node --env-file-if-exists=.env server/index.js",
    "start:field": "node setup.js --start",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "native:sync": "npm run build && cap sync",
    "android": "npm run native:sync && cap open android",
    "ios": "npm run native:sync && cap open ios",
    "setup:models": "node setup-models.js",
    "start:experts": "node setup.js --start --experts",
    "setup": "node setup.js",
    "doctor": "node setup.js --check",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "multer": "^2.0.2",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "vite": "^7.0.0"
  }
}
